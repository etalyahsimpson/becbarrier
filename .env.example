# BECBarrier environment template — PLACEHOLDERS ONLY.
# Never commit real values. Generate local development secrets with:
#   bash scripts/setup-demo.sh
# Production mode fails closed when required keys are absent.

# --- runtime mode -----------------------------------------------------------
# development | test | production
APP_ENV=development
PORT=4000

# --- database (least-privilege runtime role; migrations use the superuser URL)
DATABASE_URL=postgresql://bb_api:CHANGE_ME@localhost:5432/becbarrier_dev
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/becbarrier_dev
WORKER_DATABASE_URL=postgresql://bb_worker:CHANGE_ME@localhost:5432/becbarrier_dev
AUDIT_DATABASE_URL=postgresql://bb_audit_ro:CHANGE_ME@localhost:5432/becbarrier_dev

# --- secrets (hex, 64 chars = 32 bytes). Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=CHANGE_ME_64_HEX_CHARS
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
PAYMENT_FINGERPRINT_KEY=CHANGE_ME_64_HEX_CHARS
AUDIT_HMAC_KEY=CHANGE_ME_64_HEX_CHARS
INTERNAL_SERVICE_TOKEN=CHANGE_ME_RANDOM_TOKEN
ERP_ACK_SECRET=CHANGE_ME_RANDOM_TOKEN

# --- identity ---------------------------------------------------------------
# Local demo identity adapter is ONLY enabled in development/test.
# Production requires a real OIDC provider and fails closed without it.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

# --- email intelligence (Python FastAPI, internal network only) -------------
EMAIL_INTELLIGENCE_URL=http://localhost:8001
UPLOAD_MAX_BYTES=2097152
EMAIL_RULESET_VERSION=bec-rules-v1

# --- financial workflow policy ----------------------------------------------
CALLBACK_EXPIRY_HOURS=72

# --- ephemeral infrastructure (optional; never a financial authority) -------
REDIS_URL=

# --- web --------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
