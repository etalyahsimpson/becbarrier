      },
      "expect": {
        "status": 200,
        "state": "CALLBACK_VERIFIED"
      }
    },
    {
      "actor": "atlas-approver1",
      "action": "decide",
      "input": {
        "revision": 1,
        "decision": "APPROVE"
      },
      "expect": {
        "status": 200,
        "state": "APPROVAL_1"
      }
    },
    {
      "actor": "atlas-approver2",
      "action": "decide",
      "input": {
        "revision": 1,
        "decision": "APPROVE"
      },
      "expect": {
        "status": 200,
        "state": "APPROVAL_2"
      }
    },
    {
      "actor": "atlas-initiator",
      "action": "revise",
      "input": {
        "expectedRevision": 1,
        "proposed": {
          "accountIdentifier": "GB00SYNT00009988776655",
          "beneficiaryName": "Vulcan Steel Supplies Ltd \u2014 Treasury",
          "bankName": "Example Trust Bank",
          "currency": "GBP"
        },
        "reason": "Bank reissued the account."
      },
      "expect": {
        "status": 201,
        "state": "ON_HOLD",
        "revision": 2
      }
    },
    {
      "actor": "atlas-approver1",
      "action": "release",
      "input": {
        "revision": 2
