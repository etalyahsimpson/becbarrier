      "expect": {
        "status": 422,
        "code": "INVALID_TRANSITION"
      }
    },
    {
      "actor": "atlas-approver1",
      "action": "decide",
      "input": {
        "revision": 2,
        "decision": "APPROVE"
      },
      "expect": {
