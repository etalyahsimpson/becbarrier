{
  "id": "BC-N12",
  "category": "negative",
  "description": "ERP acknowledgment with a mismatching releaseRef is refused",
  "tenant": "atlas",
  "supplier": "vulcan-steel",
  "steps": [
    {
      "actor": "atlas-initiator",
      "action": "create",
      "input": {
        "proposed": {
          "accountIdentifier": "GB00SYNT00001122334455",
          "beneficiaryName": "Vulcan Steel Supplies Ltd",
          "bankName": "Example Trust Bank",
          "currency": "GBP"
        },
        "reason": "ERP releaseRef test."
      },
      "expect": {
        "status": 201,
        "state": "ON_HOLD",
        "revision": 1
      }
    },
    {
      "actor": "atlas-verifier",
      "action": "verify",
      "input": {
        "revision": 1,
        "approvedContactId": "@contact:vulcan-phone",
        "result": "CONFIRMED",
        "method": "APPROVED_DIRECTORY_CONTACT",
        "evidenceRef": "call-log-2026-11-21"
      },
      "expect": {
        "status": 200,
        "state": "CALLBACK_VERIFIED"
      }
    },
    {
      "actor": "atlas-approver1",
      "action": "decide",
      "input": {
        "revision": 1,
        "decision": "APPROVE"
      },
      "expect": {
        "status": 200,
        "state": "APPROVAL_1"
      }
    },
    {
      "actor": "atlas-approver2",
      "action": "decide",
      "input": {
        "revision": 1,
        "decision": "APPROVE"
      },
      "expect": {
        "status": 200,
        "state": "APPROVAL_2"
      }
    },
    {
      "actor": "atlas-approver1",
      "action": "release",
      "input": {
        "revision": 1
      },
      "expect": {
        "status": 200,
        "state": "RELEASED_FOR_ERP_UPDATE"
      }
    },
    {
      "actor": "atlas-admin",
      "action": "erp-ack",
      "input": {
        "releaseRef": "00000000-0000-4000-8000-000000000000",
        "revision": 1,
        "externalReceipt": "ERP-RCPT-MISMATCH"
      },
      "useReleaseRef": false,
      "wrongSecret": false,
      "expect": {
        "status": 422,
        "code": "INVALID_TRANSITION"
      }
    }
  ],
  "finalState": "RELEASED_FOR_ERP_UPDATE",
  "expectAuditEventTypes": [],
  "idempotentSteps": true
}